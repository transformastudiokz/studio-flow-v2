[Unit]
Description=OneFit to CRM scheduled sync
After=network-online.target onefit-browser.service
Wants=network-online.target
Requires=onefit-browser.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/onefit-sync
ExecStart=/bin/bash -lc 'set -a; source /etc/onefit-sync.env; set +a; exec /usr/bin/node /opt/onefit-sync/src/sync-range.mjs'
TimeoutStartSec=900
MemoryMax=650M

[Install]
WantedBy=multi-user.target
