[Unit]
Description=OneFit to CRM scheduled sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=onefit-sync
Group=onefit-sync
WorkingDirectory=/opt/onefit-sync
EnvironmentFile=/etc/onefit-sync.env
Environment=ONEFIT_HEADLESS=false
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node /opt/onefit-sync/src/sync-range.mjs
TimeoutStartSec=900
MemoryMax=650M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
