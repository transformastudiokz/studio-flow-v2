[Unit]
Description=OneFit manual sync request worker
After=network-online.target onefit-browser.service
Wants=network-online.target
Requires=onefit-browser.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/onefit-sync
ExecStart=/bin/bash -lc 'set -a; source /etc/onefit-sync.env; set +a; exec /usr/bin/node /opt/onefit-sync/src/worker.mjs'
Restart=always
RestartSec=10
MemoryMax=700M

[Install]
WantedBy=multi-user.target
