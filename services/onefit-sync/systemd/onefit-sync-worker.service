[Unit]
Description=OneFit manual sync request worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=onefit-sync
Group=onefit-sync
WorkingDirectory=/opt/onefit-sync
EnvironmentFile=/etc/onefit-sync.env
Environment=ONEFIT_HEADLESS=false
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node /opt/onefit-sync/src/worker.mjs
Restart=always
RestartSec=10
MemoryMax=700M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
